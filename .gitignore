# ───────────── macOS / editors ─────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.swp
*~
.vscode/
.fleet/
.idea/
*.iml

# ───────────── Secrets / local config ─────────────
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
keystore.properties
